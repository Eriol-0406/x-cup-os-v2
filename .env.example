# LLM parser (Groq + Llama 3.3 70B)
GROQ_API_KEY=

# Live football data — World Cup config
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
WC_LEAGUE_ID=1
# WC seasons: 2022 (Qatar, free-tier OK), 2026 (USA/Canada/Mexico, requires paid plan)
WC_SEASON=2022
FIXTURE_CACHE_TTL=3600

# X Layer testnet
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_CHAIN_ID=1952
XLAYER_EXPLORER=https://www.oklink.com/x-layer-testnet

# Deployer (fund with testnet OKB from the X Layer faucet)
DEPLOYER_PRIVATE_KEY=

# Burner wallet encryption (32-byte hex)
BURNER_ENCRYPTION_KEY=

# Database
DATABASE_URL=file:./dev.db
# Swap to Postgres when ready:
# DATABASE_URL=postgresql://xcup:xcup@localhost:5432/xcup

# API server
PORT=4000
WEB_ORIGIN=http://localhost:3001
