{
  "name": "x-cup-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI agents that deploy plain-English betting strategies on X Layer World Cup prediction markets",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contract:build": "cd contracts && forge build",
    "contract:test": "cd contracts && forge test -vv",
    "contract:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url $XLAYER_TESTNET_RPC --broadcast"
  },
  "engines": {
    "node": ">=20"
  }
}
