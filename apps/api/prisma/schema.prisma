// X-Cup OS API database — SQLite for Day 1 dev, swap to Postgres later by
// changing `provider` to "postgresql" and the DATABASE_URL in .env.
//
// Schema kept minimal — we add tables as features land. Day 2 only needs
// User + Strategy. StrategyFire + MatchCache get added when the watch loop
// is wired up.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String     @id @default(cuid())
  mainWallet               String     @unique // EVM checksum address
  agentWallet              String?    @unique // generated burner address
  agentWalletEncryptedKey  String?    // AES-256-GCM ciphertext (base64); null until generated
  createdAt                DateTime   @default(now())
  strategies               Strategy[]
}

model Strategy {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  englishText   String    // original user input
  parsedJson    String    // serialized ParsedStrategy from packages/types
  status        String    @default("draft") // draft | active | paused | expired | exhausted
  maxLossUsdc   Float?    // copied out of parsedJson.riskLimits for fast queries
  currentPnlUsdc Float    @default(0)
  fireCount     Int       @default(0)
  /// JSON array of on-chain market ids this strategy is allowed to fire on.
  /// Resolved at deploy time from the team names in parsedJson.trigger.conditions.
  /// Empty array = no resolvable fixtures → strategy never fires.
  targetMarketIds String  @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fires         StrategyFire[]
  claims        Claim[]

  @@index([userId])
  @@index([status])
}

/// One row per agent fire. Recorded whether the on-chain tx succeeds or
/// fails so the activity dashboard can show users 'agent tried to stake X
/// but the market closed' alongside successful stakes.
model StrategyFire {
  id              String    @id @default(cuid())
  strategyId      String
  strategy        Strategy  @relation(fields: [strategyId], references: [id])
  marketId        Int       // on-chain XCupMarket id
  outcomeIdx      Int       // 0 = YES, 1 = NO (binary); 0/1/2 for ternary
  stakeUsdc       Float
  txHash          String?   // null while pending submission
  status          String    // pending | confirmed | failed
  failureReason   String?   // populated on status == failed
  matchEventJson  String    // the event payload that triggered this fire
  createdAt       DateTime  @default(now())

  @@index([strategyId])
  @@index([status])
}

/// Mirror of an API-Football fixture (one of the 64 WC 2022 or 104 WC 2026
/// matches). Updated by the sync service from /fixtures?league=X&season=Y.
/// Source of truth for matchups, scores, status — the on-chain market is
/// pure betting state.
/// Cached API-Football team metadata so we can render group letters / logos
/// without re-hitting the API on every page load.
model Team {
  id           Int      @id                   // API-Football team id
  name         String
  code         String?
  country      String?
  logo         String
  season       Int
  groupLetter  String?                        // "A".."L" — pulled from standings
  cachedAt     DateTime @default(now())

  @@index([season])
  @@index([groupLetter])
}

model Fixture {
  id              Int       @id              // API-Football fixture id
  date            DateTime
  status          String                     // NS | 1H | HT | 2H | ET | P | FT | AET | PEN | PST | CANC | ABD
  round           String                     // "Group Stage - 1", "Round of 16", "Final", etc
  homeTeamId      Int
  homeTeamName    String
  homeTeamLogo    String
  awayTeamId      Int
  awayTeamName    String
  awayTeamLogo    String
  homeGoals       Int?
  awayGoals       Int?
  penaltyHome     Int?
  penaltyAway     Int?
  venueName       String?
  venueCity       String?
  group           String?                    // "Group A", "Group B", ...
  rawJson         String                     // full API response for any extra data we need later
  updatedAt       DateTime  @updatedAt
  market          FixtureMarket?
  playerProps     PlayerPropMarket[]

  @@index([status])
  @@index([date])
  @@index([round])
}

/// Mapping table: which on-chain marketId corresponds to which API-Football
/// fixtureId. Created when admin runs POST /admin/create-markets.
model FixtureMarket {
  fixtureId       Int       @id
  fixture         Fixture   @relation(fields: [fixtureId], references: [id])
  marketId        Int       @unique          // on-chain XCupMarket id
  outcomeCount    Int                        // 2 (knockout) or 3 (group)
  createMarketTx  String
  createdAt       DateTime  @default(now())
}

/// Yes/No opinion markets — "Will an unbeaten champion emerge?", "Will the
/// Golden Boot winner be European?", etc. Each is a binary XCupMarket with
/// outcome 0 = YES, outcome 1 = NO. Settled manually by admin at tournament
/// end (or when the question is resolved). Optional friend-only allowlist.
model PredictionMarket {
  id              String    @id @default(cuid())
  slug            String    @unique         // url-safe id, e.g. "unbeaten-champion-2022"
  question        String                     // human-readable
  category        String    @default("Tournament") // "Tournament" | "Player" | "Special"
  season          Int
  marketId        Int       @unique          // on-chain XCupMarket id
  createMarketTx  String
  settled         Boolean   @default(false)
  winningOutcome  Int?                       // 0 = YES, 1 = NO
  /// Friend-only flag (Pillar 1 social-trust angle). Empty allowlist = public.
  isPrivate       Boolean   @default(false)
  allowlistJson   String    @default("[]")   // JSON array of EVM addresses
  createdAt       DateTime  @default(now())

  @@index([season])
  @@index([settled])
  @@index([category])
}

/// Per-fixture prop markets beyond match-winner. v1: "first goal scorer".
/// Outcomes are dynamic — built from the fixture's actual goal scorers
/// (cap 7 distinct players + an "Other / no scorer" catch-all bucket).
/// Settled by the replay flow with the actual first scorer.
model PlayerPropMarket {
  id              String    @id @default(cuid())
  fixtureId       Int
  fixture         Fixture   @relation(fields: [fixtureId], references: [id])
  /// "first_scorer" for v1; future: "anytime_scorer", "over_under_goals", etc.
  type            String
  marketId        Int       @unique          // on-chain XCupMarket id
  outcomeCount    Int
  /// JSON: [{ idx, label, playerName?, teamName? }]
  outcomesJson    String
  settled         Boolean   @default(false)
  winningOutcome  Int?
  createMarketTx  String
  createdAt       DateTime  @default(now())

  @@unique([fixtureId, type])
  @@index([type])
}

/// Pillar 1 — long-term "Team X wins the tournament" outcome shares.
/// One row per (season, team). Binary YES/NO market on whether the team
/// lifts the trophy. Settled by oracle when the tournament ends.
model TournamentMarket {
  id              String    @id @default(cuid())
  season          Int                        // env.WC_SEASON snapshot at create
  teamId          Int                        // API-Football team id
  teamName        String
  teamLogo        String
  teamCode        String?                    // "ARG", "FRA", etc
  /// "winner" (does team X win the cup?) | "to_reach_final" | "to_reach_sf" |
  /// "to_reach_qf" | "to_reach_r16"
  type            String    @default("winner")
  marketId        Int       @unique          // on-chain XCupMarket id
  outcomeCount    Int       @default(2)      // always binary for per-team outrights
  createMarketTx  String
  settled         Boolean   @default(false)
  /// 0 = YES (team achieved this milestone), 1 = NO
  winningOutcome  Int?
  createdAt       DateTime  @default(now())

  @@unique([season, teamId, type])
  @@index([season])
  @@index([type])
  @@index([settled])
}

/// Tournament-wide multi-outcome outrights — "Top Goalscorer" (8 player
/// candidates), "Group A Winner" (4 teams), "Best Young Player" etc.
/// Settled manually by admin.
model TournamentSpecial {
  id              String    @id @default(cuid())
  season          Int
  slug            String    @unique          // "top-scorer-2022", "group-a-winner-2022"
  question        String                     // human-readable
  /// "top_scorer" | "group_winner" | "best_young_player" | "best_goalkeeper" |
  /// "winning_continent" | "first_time_winner" | etc.
  type            String
  groupLetter     String?                    // for group_winner: "A".."L"
  marketId        Int       @unique          // on-chain XCupMarket id
  outcomeCount    Int
  /// JSON: [{ idx, label, teamId?, teamLogo?, playerName? }]
  outcomesJson    String
  settled         Boolean   @default(false)
  winningOutcome  Int?
  createMarketTx  String
  createdAt       DateTime  @default(now())

  @@index([season])
  @@index([type])
  @@index([groupLetter])
}

/// One row per claim event (after market settlement). Auto-created by the
/// oracle settle flow when a strategy has winning stakes on a market.
model Claim {
  id              String    @id @default(cuid())
  strategyId      String
  strategy        Strategy  @relation(fields: [strategyId], references: [id])
  marketId        Int
  payoutUsdc      Float     // gross payout (incl. original stake)
  txHash          String?
  status          String    // pending | confirmed | failed
  failureReason   String?
  createdAt       DateTime  @default(now())

  @@unique([strategyId, marketId]) // one claim per strategy per market
  @@index([status])
}
